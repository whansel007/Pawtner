# Dependencies
node_modules/
.pnp
.pnp.js

# Secrets: NEVER commit. Keep a .env.example with blank values instead.
.env
.env.*
!.env.example
*.pem
*.key

# Build output
dist/
build/
.vite/
*.tsbuildinfo
# EdgeOne Pages Function (generated by npm run build:edgeone)
functions/api/[[path]].mjs

# Hosting / serverless tooling (local state and cache)
.vercel/
.netlify/
.edgeone/
.wrangler/
.serverless/
.output/

# Test and coverage
coverage/
.nyc_output/
test-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local database dumps and scratch data (seed.sql with FICTIONAL data is fine to commit)
*.dump
*.sqlite
*.sqlite3
pgdata/
tmp/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# AI coding tool local state (adjust if your tool needs these committed)
.codebuddy/cache/
vitest-json.txt
vitest-out.txt

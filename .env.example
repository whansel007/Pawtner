# Pooled Supabase Postgres URL used by the deployed API. Leave blank until credentials are supplied.
DATABASE_URL=
# Direct Supabase Postgres URL used only by migrations and local seeding. Leave blank until supplied.
DATABASE_URL_DIRECT=
# OpenAI-compatible LLM API base URL. Leave blank until the model is selected.
# Example: https://integrate.api.nvidia.com/v1  (NVIDIA free endpoint, build.nvidia.com)
# Example: https://api.openai.com/v1           (OpenAI)
LLM_BASE_URL=
# Text model identifier for rephrasing and decision wording. Leave blank to use
# the default gpt-4o-mini. Available NVIDIA free models (Oct 2026):
#   nvidia/nemotron-3-ultra-550b-a55b       (high quality, slower)
#   nvidia/nemotron-3.5-lightning-30b-a3b   (reasoning model, fast)
LLM_MODEL=
# Vision model identifier for pill description/verification. Falls back to
# LLM_MODEL if unset. Available NVIDIA free vision model (Oct 2026):
#   meta/muse-glimmer-30b   (multimodal reasoning model)
LLM_VISION_MODEL=
# LLM API key. Leave blank until supplied; rule decisions work without it.
# Get a free NVIDIA key at https://build.nvidia.com → sign in → "Get API Key".
LLM_API_KEY=
# Public API base URL consumed by the Vite app. Leave blank until deployment.
#
# Default behaviour: the mobile app calls relative `/api/*` and Vite (dev) or
# Vercel (prod) routes those to the serverless function in the same project.
# Only set VITE_API_BASE_URL when the API lives on a different origin
# (e.g. an EdgeOne Pages Function for the static front-end, with the API
# on Vercel — see docs/HANDOFF.md for the cross-origin CORS setup).
VITE_API_BASE_URL=

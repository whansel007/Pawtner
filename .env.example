# Pooled Supabase Postgres URL used by the deployed API. Leave blank until credentials are supplied.
DATABASE_URL=
# Direct Supabase Postgres URL used only by migrations and local seeding. Leave blank until supplied.
DATABASE_URL_DIRECT=
# OpenAI-compatible TokenHub base URL. Leave blank until the model is selected.
LLM_BASE_URL=
# TokenHub model identifier. Leave blank until the model is selected.
LLM_MODEL=
# TokenHub API key. Leave blank until supplied; rule decisions work without it.
LLM_API_KEY=
# Public API base URL consumed by the Vite app. Leave blank until deployment.
VITE_API_BASE_URL=
